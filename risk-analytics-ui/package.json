{
  "name": "risk-analytics-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:hybrid": "cross-env EXECUTION_MODE=hybrid vite --port 5173",
    "dev:local": "cross-env EXECUTION_MODE=local vite --port 5173",
    "dev:docker": "cross-env EXECUTION_MODE=docker vite --port 5173",
    "backend:dev": "cd .. && uvicorn api.backend:app --reload --port 8000",
    "backend:hybrid": "cd .. && cross-env EXECUTION_MODE=hybrid uvicorn api.backend:app --reload --port 8000",
    "backend:local": "cd .. && cross-env EXECUTION_MODE=local uvicorn api.backend:app --reload --port 8000",
    "dev:all": "concurrently \"npm run backend:dev\" \"npm run dev\"",
    "dev:all:hybrid": "concurrently \"npm run backend:hybrid\" \"npm run dev:hybrid\"",
    "dev:all:local": "concurrently \"npm run backend:local\" \"npm run dev:local\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "zustand": "^4.4.0",
    "recharts": "^2.10.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "cross-env": "^7.0.0",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.0"
  }
}
